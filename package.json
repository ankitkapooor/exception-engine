    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
